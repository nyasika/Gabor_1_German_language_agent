    { "id": "G04-10", "type": "errorspot", "topic": "G04", "prompt": "Tap the word in the wrong place.", "tokens": ["Du", "musst", "nicht", "kommen", "heute."], "wrongIndex": 4, "fixed": "Du musst heute nicht kommen.", "explain": "Time expressions like heute usually come right after the modal verb, before nicht." },
